# OMDA 2 / example only. Copy to .env ON THE OCI VM and chmod 600.
# NEVER commit the populated .env file. Both secrets must be independent.
# Use an image digest with verified linux/arm64 support from the official GHCR repository.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest
PAPERCLIP_PUBLIC_URL=https://REPLACE-WITH-VM.TAILNET.ts.net
PAPERCLIP_ALLOWED_HOSTNAMES=REPLACE-WITH-VM.TAILNET.ts.net
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
